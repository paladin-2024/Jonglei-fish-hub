# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
# On Render, DATABASE_URL is injected automatically — use that instead of the
# individual DB_* vars below. Locally, leave DATABASE_URL unset and set the
# individual vars.
DATABASE_URL=

DB_NAME=jonglei_fish_hub
DB_USER=jonglei_admin
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# ── Redis / Celery ─────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Firebase (FCM push notifications) ─────────────────────────────────────────
# Download from Firebase Console → Project Settings → Service Accounts
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# ── Sentry error tracking ──────────────────────────────────────────────────────
# Get DSN from sentry.io → Project → Settings → Client Keys
SENTRY_DSN=

# ── Africa's Talking (SMS OTP) ─────────────────────────────────────────────────
# AT_API_KEY=
# AT_USERNAME=

# ── DB backups ─────────────────────────────────────────────────────────────────
BACKUP_DIR=/backups
RETENTION_DAYS=14
